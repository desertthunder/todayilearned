---
import type { NoteEntry } from "../lib/til";
import { excerptFor, formatDate, formatMonth, groupNotesByMonth, hrefFor } from "../lib/til";
import TagList from "./TagList.astro";

interface Props {
	entries: NoteEntry[];
}

const { entries } = Astro.props;
const months = groupNotesByMonth(entries);
---

{
	entries.length > 0 ? (
		<div class="til-list">
			{months.map((month) => (
				<section class="til-month" aria-labelledby={`month-${month.date.toISOString()}`}>
					<h2 class="til-month__heading" id={`month-${month.date.toISOString()}`}>
						{formatMonth(month.date)}
					</h2>
					{month.days.map((day) => (
						<section class="til-day" aria-labelledby={`day-${day.date.toISOString()}`}>
							<h3 class="til-day__date" id={`day-${day.date.toISOString()}`}>
								<time datetime={day.date.toISOString()}>{formatDate(day.date, { year: undefined })}</time>
							</h3>
							<ol class="til-day__entries">
								{day.entries.map((entry, index) => {
									const excerpt = excerptFor(entry);
									const showOrdinal = day.entries.length > 1;

									return (
										<li class:list={["til-list__item", { "til-list__item--numbered": showOrdinal }]}>
											<article class="til-card">
												<h4 class="til-card__title">
													{showOrdinal && (
														<span class="til-list__ordinal" aria-hidden="true">
															{index + 1}.
														</span>
													)}
													<a href={hrefFor(entry)}>{entry.data.title}</a>
												</h4>
												{excerpt && <p class="til-card__excerpt">{excerpt}</p>}
												<TagList tags={entry.data.tags} />
											</article>
										</li>
									);
								})}
							</ol>
						</section>
					))}
				</section>
			))}
		</div>
	) : (
		<p class="archive-empty">The archive is waiting for its first field note.</p>
	)
}

<style>
	.til-list {
		display: grid;
		gap: var(--space-8);
	}

	.til-month__heading {
		padding-bottom: var(--space-4);
		border-bottom: 1px solid var(--color-border);
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: -0.025em;
	}

	.til-day {
		display: grid;
		grid-template-columns: 4.25rem minmax(0, 1fr);
		border-bottom: 1px solid var(--color-border);
	}

	.til-day__date {
		padding-top: var(--space-4);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.03em;
		line-height: 1.4;
		display: flex;
		align-items: center;
	}

	.til-day__entries {
		list-style: none;
	}

	.til-list__item {
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
	}

	.til-list__item:last-child {
		border-bottom: 0;
	}

	.til-list__item--numbered {
		display: flex;
		align-items: center;
		gap: var(--space-5);
	}

	.til-list__ordinal {
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		line-height: 1.15;
	}

	.til-card {
		padding-block: var(--space-4);
	}

	.til-card__title {
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.4vw, 1.65rem);
		font-weight: 500;
		letter-spacing: -0.035em;
		line-height: 1.15;
		margin-top: 0;
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.til-card__title a {
		text-decoration: none;
	}

	.til-card:hover .til-card__title a {
		color: var(--color-accent);
	}

	.til-card__excerpt {
		margin-top: var(--space-1);
		color: var(--color-muted);
		font-size: var(--text-base);
		line-height: 1.58;
	}

	.til-card :global(.tag-list) {
		margin-top: var(--space-2);
	}

	.archive-empty {
		padding: var(--space-5) 0;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-muted);
	}

	@media (max-width: 32rem) {
		.til-day {
			display: block;
		}

		.til-day__date {
			padding-top: var(--space-4);
		}

		.til-card {
			padding-top: var(--space-2);
		}
	}
</style>
