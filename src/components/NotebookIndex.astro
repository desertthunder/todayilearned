---
import type { NoteEntry } from "../lib/til";
import { dateFromId, formatDate, formatMonth, groupNotesByMonth, hrefFor } from "../lib/til";

type Props = { entries: NoteEntry[]; currentId?: string };

const { entries, currentId } = Astro.props;
const months = groupNotesByMonth(entries);
const isTopicsPage = Astro.url.pathname.startsWith("/topics/") || Astro.url.pathname === "/topics";
---

<div class="site-library">
	<nav class="site-browse" aria-label="Browse notes">
		<p class="site-browse__heading">Browse</p>
		<div class="site-browse__links">
			<a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Recent</a>
			<a href="/topics/" aria-current={isTopicsPage ? "page" : undefined}>Topics</a>
		</div>
	</nav>

	<nav class="site-index" aria-label="Notebook index">
		<p class="site-index__heading">
			<span>Notebook</span>
			<span>{entries.length}</span>
		</p>
		{
			entries.length > 0 ? (
				<ol class="site-index__months">
					{months.map((month) => (
						<li class="site-index__month">
							<p class="site-index__month-heading">
								<span>{formatMonth(month.date)}</span>
								<span>{month.entries.length}</span>
							</p>
							<ol class="site-index__list">
								{month.entries.map((entry) => {
									const date = dateFromId(entry.id)!;

									return (
										<li>
											<a
												class="site-index__link"
												href={hrefFor(entry)}
												aria-current={entry.id === currentId ? "page" : undefined}>
												<time class="site-index__date" datetime={date.toISOString()}>
													{formatDate(date, { year: undefined })}
												</time>
												<span class="site-index__title">{entry.data.title}</span>
											</a>
										</li>
									);
								})}
							</ol>
						</li>
					))}
				</ol>
			) : (
				<p class="site-index__empty">The notebook is waiting for its first note.</p>
			)
		}
	</nav>
</div>

<style>
	.site-library {
		border-top: 1px solid var(--color-border);
	}

	.site-browse {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-4);
		border-bottom: 1px solid var(--color-border);
	}

	.site-browse__heading,
	.site-index__heading,
	.site-index__month-heading {
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: 0.64rem;
		font-weight: 500;
		letter-spacing: var(--tracking-caps);
		text-transform: uppercase;
	}

	.site-browse__links {
		display: flex;
		gap: var(--space-4);
		font-size: var(--text-sm);
	}

	.site-browse__links a {
		text-decoration: none;
	}

	.site-browse__links a[aria-current="page"] {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.site-index {
		min-width: 0;
	}

	.site-index__heading {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-4);
		background-color: var(--color-surface-raised);
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
	}

	.site-index__months,
	.site-index__list {
		list-style: none;
	}

	.site-index__month-heading {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4) var(--space-2);
		background: var(--color-bg);
		font-size: 0.58rem;
	}

	.site-index__link {
		display: block;
		padding: var(--space-4);
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
		text-decoration: none;
		background-color: var(--color-surface);
	}

	.site-index__link:hover,
	.site-index__link[aria-current="page"] {
		color: var(--color-accent);
		background: var(--color-selection);
	}

	.site-index__link[aria-current="page"] {
		padding-left: var(--space-2);
		border-left: 2px solid var(--color-accent);
	}

	.site-index__date,
	.site-index__title {
		display: block;
	}

	.site-index__date {
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		line-height: 1.35;
	}

	.site-index__title {
		margin-top: 0.08rem;
		font-family: var(--font-serif);
		font-size: var(--text-sm);
		line-height: 1.25;
	}

	.site-index__empty {
		padding-block: var(--space-3);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		line-height: 1.5;
	}
</style>
