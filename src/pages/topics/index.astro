---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNotes, tagCounts, topicHrefFor, topicLabel } from "../../lib/til";

const entries = await getNotes();
const topics = tagCounts(entries).sort((left, right) => topicLabel(left.tag).localeCompare(topicLabel(right.tag)));
---

<BaseLayout title="Topics" description="Browse Today I Learned notes by topic.">
	<div class="topics-page">
		<header class="topics-page__header">
			<a class="back-link" href="/">← Recent notes</a>
			<h1>Topics</h1>
			<p>{topics.length} topics across {entries.length} notes.</p>
		</header>

		<ul class="topic-index">
			{
				topics.map(({ tag, count }) => (
					<li>
						<a href={topicHrefFor(tag)}>
							<span>{topicLabel(tag)}</span>
							<span>
								{count} {count === 1 ? "note" : "notes"}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.topics-page__header {
		padding-bottom: var(--space-8);
		border-bottom: 1px solid var(--color-border);
	}

	.back-link {
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration-style: dotted;
	}

	.topics-page__header h1 {
		margin-top: var(--space-10);
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		line-height: 1;
	}

	.topics-page__header p {
		margin-top: var(--space-4);
		color: var(--color-muted);
	}

	.topic-index {
		list-style: none;
	}

	.topic-index li {
		border-bottom: 1px solid var(--color-border);
	}

	.topic-index a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-5);
		padding-block: var(--space-4);
		font-family: var(--font-serif);
		font-size: var(--text-md);
		text-decoration: none;
	}

	.topic-index a span:last-child {
		flex: 0 0 auto;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
	}

	.topic-index a:hover span:last-child {
		color: var(--color-accent);
	}
</style>
