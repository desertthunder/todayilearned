---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TilList from "../../components/TilList.astro";
import type { NoteEntry } from "../../lib/til";
import { getNotes, tagCounts, topicLabel } from "../../lib/til";

export async function getStaticPaths() {
	const entries = await getNotes();

	return tagCounts(entries).map(({ tag }) => ({
		params: { tag },
		props: { entries: entries.filter((entry) => entry.data.tags.includes(tag)), tag },
	}));
}

interface Props {
	entries: NoteEntry[];
	tag: string;
}

const { entries, tag } = Astro.props;
const label = topicLabel(tag);
---

<BaseLayout title={label} description={`Today I Learned notes filed under ${label}.`}>
	<div class="topic-page">
		<header class="topic-page__header">
			<a class="back-link" href="/topics/">← All topics</a>
			<p class="eyebrow">Topic</p>
			<h1>{label}</h1>
			<p>{entries.length} {entries.length === 1 ? "note" : "notes"}</p>
		</header>

		<section class="topic-page__notes" aria-label={`${label} notes`}>
			<TilList entries={entries} />
		</section>
	</div>
</BaseLayout>

<style>
	.topic-page__header {
		padding-bottom: var(--space-8);
		border-bottom: 1px solid var(--color-border);
	}

	.back-link {
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration-style: dotted;
	}

	.topic-page__header .eyebrow {
		margin-top: var(--space-10);
	}

	.topic-page__header h1 {
		margin-top: var(--space-2);
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		line-height: 1;
	}

	.topic-page__header > p:last-child {
		margin-top: var(--space-4);
		color: var(--color-muted);
	}

	.topic-page__notes {
		padding-top: var(--space-8);
	}
</style>
