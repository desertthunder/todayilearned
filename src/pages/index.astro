---
import BaseLayout from "../layouts/BaseLayout.astro";
import TilList from "../components/TilList.astro";
import { getNotes, tagCounts, topicHrefFor, topicLabel } from "../lib/til";

const entries = await getNotes();
const recurringTopics = tagCounts(entries)
	.filter(({ count }) => count > 1)
	.slice(0, 5);
---

<BaseLayout>
	<div class="archive-page">
		<header class="archive-page__header">
			<h1>Recent Notes</h1>
			<div class="archive-page__lede">
				<p>
					TIL - <a href="https://www.reddit.com/r/todayilearned/">Today I Learned</a>
				</p>
				<p>Small, short, daily notes.</p>
				<span>
					total: {entries.length}&nbsp;{entries.length === 1 ? "note" : "notes"}
				</span>
			</div>
		</header>
		<nav class="topic-browse" aria-labelledby="topic-browse-title">
			<p class="topic-browse__label" id="topic-browse-title">Browse topics</p>
			<ul>
				<li><a href="#latest">All</a></li>
				{
					recurringTopics.map(({ tag, count }) => (
						<li>
							<a href={topicHrefFor(tag)}>
								{topicLabel(tag)} <span>{count}</span>
							</a>
						</li>
					))
				}
				<li><a href="/topics/">More topics</a></li>
			</ul>
		</nav>

		<section class="archive-section" id="latest" aria-label="Recent notes">
			<TilList entries={entries} />
		</section>
	</div>
</BaseLayout>

<style>
	.archive-page__header {
		padding-bottom: var(--space-8);
		border-bottom: 1px solid var(--color-border);
	}

	.archive-page__header h1 {
		margin-top: var(--space-3);
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		line-height: 1;
	}

	.archive-page__lede {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		margin-top: var(--space-4);
		color: var(--color-muted);
		font-size: var(--text-base);
		line-height: 1.55;
	}

	.archive-section {
		padding-top: var(--space-8);
	}

	.topic-browse {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: var(--space-4) var(--space-6);
		padding-block: var(--space-5);
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
	}

	.topic-browse__label {
		color: var(--color-muted);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: var(--tracking-caps);
		text-transform: uppercase;
	}

	.topic-browse ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		list-style: none;
	}

	.topic-browse a {
		text-decoration-style: dotted;
	}

	.topic-browse a span {
		margin-left: 0.15em;
		color: var(--color-muted);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 38rem) {
		.topic-browse {
			grid-template-columns: 1fr;
		}
	}
</style>
